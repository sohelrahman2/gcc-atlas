# GCC Atlas needs no secrets to run: the seed data is local.
#
# Optional. "deterministic" (default) answers from the local seed dataset.
# "claude" is a placeholder: the API route returns a clear 501 "not connected"
# error until a server-side provider is implemented (see README).
ASSISTANT_PROVIDER=deterministic

# Reserved for the future server-side Claude integration. Never prefix with
# NEXT_PUBLIC_, and never commit a real key. Unused today.
# ANTHROPIC_API_KEY=
